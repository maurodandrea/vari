rules_version = '2';
// Regole di sicurezza per Lenza: ogni utente legge e scrive solo i propri dati (users/{uid}/...).
// Da incollare in Console Firebase › Firestore Database › Regole › Pubblica.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
