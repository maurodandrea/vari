rules_version = '2';
// Regole di sicurezza per Lenza. Da incollare in Console Firebase › Firestore Database › Regole › Pubblica.
// - ogni utente legge e scrive solo i propri dati (users/{uid}/...);
// - chi si registra con email e password deve prima attivare l'account dal link ricevuto per email
//   (Google e Apple hanno già l'email verificata);
// - chat: stanze pubbliche per zona, messaggi privati e gruppi visibili solo ai membri.
service cloud.firestore {
  match /databases/{database}/documents {
    function attivo() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider != 'password');
    }
    // amministratori: vedono e gestiscono le segnalazioni
    function admin() {
      return attivo() && request.auth.token.email_verified == true
        && request.auth.token.email in ['chesterfieldsoftred@gmail.com'];
    }
    function bloccato() { return exists(/databases/$(database)/documents/banned/$(request.auth.uid)); }
    function miaPosizione() { return exists(/databases/$(database)/documents/locations/$(request.auth.uid)); }
    function stanza(rid) { return get(/databases/$(database)/documents/rooms/$(rid)).data; }
    function membro(r) { return r.type == 'zone' || request.auth.uid in r.members; }

    match /users/{uid}/{document=**} {
      allow read, write: if attivo() && request.auth.uid == uid;
      // l'amministratore può cercare e cancellare i dati di un utente (pagina Segnalazioni › Cancella utente)
      allow read, delete: if admin();
    }

    // profilo pubblico: nome e codice amico
    match /profiles/{uid} {
      allow read: if attivo();
      allow write: if attivo() && request.auth.uid == uid;
      allow delete: if admin();
    }

    // stanze della chat
    match /rooms/{rid} {
      allow read: if attivo() && (resource == null || membro(resource.data));
      allow create: if attivo() && (request.resource.data.type == 'zone' || request.auth.uid in request.resource.data.members);
      // gruppi: chi l'ha creato cambia nome e membri; gli altri membri possono solo uscire
      allow update: if attivo() && membro(resource.data)
        && request.resource.data.type == resource.data.type
        && request.resource.data.get('owner', null) == resource.data.get('owner', null)
        && (resource.data.type == 'zone'
            || request.resource.data.members == resource.data.members
            || (resource.data.type == 'group' && resource.data.owner == request.auth.uid)
            || (resource.data.type == 'group'
                && request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())));
      allow delete: if attivo() && resource.data.type == 'group' && resource.data.owner == request.auth.uid;
      // l'amministratore (Cancella utente) può leggere, modificare e cancellare le stanze
      allow read, update, delete: if admin();

      match /msgs/{mid} {
        allow read: if attivo() && (membro(stanza(rid)) || admin());
        allow create: if attivo() && !bloccato() && membro(stanza(rid)) && request.resource.data.uid == request.auth.uid;
        allow delete: if attivo() && (resource.data.uid == request.auth.uid || admin()
          || (stanza(rid).type == 'group' && stanza(rid).owner == request.auth.uid));
        // gli altri possono solo aumentare di 1 il contatore delle segnalazioni
        // oppure rispondere a un'uscita proposta (solo la propria voce in «going»)
        allow update: if attivo() && membro(stanza(rid))
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rep'])
               && (request.resource.data.rep == resource.data.get('rep', 0) + 1 || admin()))
            || (resource.data.get('kind', '') == 'trip'
               && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['going'])
               && request.resource.data.going.diff(resource.data.get('going', {})).affectedKeys().hasOnly([request.auth.uid])));
      }
    }

    // avvisi personali (risposte ai propri messaggi): chiunque può lasciarne uno, solo il destinatario li legge
    // ricerca dei messaggi di un utente in tutte le stanze (solo amministratore)
    match /{path=**}/msgs/{mid} {
      allow read, delete: if admin();
    }
    match /notifs/{uid}/items/{id} {
      allow read, delete: if (attivo() && request.auth.uid == uid) || admin();
      allow create: if attivo() && request.resource.data.fromUid == request.auth.uid;
    }

    // segnalazioni: tutti possono inviarle, solo gli amministratori le leggono e le chiudono
    match /reports/{id} {
      allow create: if attivo() && request.resource.data.by == request.auth.uid;
      allow read, delete: if admin();
    }

    // posizione condivisa sulla mappa della chat: visibile a tutti (vis 'all') o solo agli amici scelti
    match /locations/{uid} {
      // le posizioni pubbliche le vede solo chi condivide la propria con «Tutti»;
      // quelle condivise con me da un amico le vedo sempre (l'ha scelto lui); il resto lo regola l'app
      allow read: if attivo() && (request.auth.uid == uid
        || (resource.data.vis == 'all' && miaPosizione() && get(/databases/$(database)/documents/locations/$(request.auth.uid)).data.vis == 'all')
        || request.auth.uid in resource.data.friends);
      allow write: if attivo() && request.auth.uid == uid;
      allow delete: if admin();
    }

    // utenti bloccati dagli amministratori: possono leggere ma non scrivere in chat
    // catture anonime per la mappa di calore: le leggono tutti, ognuno scrive e cancella solo le proprie
    match /catchmap/{id} {
      allow read: if attivo();
      allow create: if attivo() && request.resource.data.uid == request.auth.uid
        && request.resource.data.la is number && request.resource.data.lo is number && request.resource.data.sp is string;
      allow delete: if attivo() && (resource.data.uid == request.auth.uid || admin());
    }

    // catture condivise solo con gli amici: le leggono l'autore e gli amici elencati
    match /catchfr/{id} {
      allow read: if attivo() && (resource.data.uid == request.auth.uid || request.auth.uid in resource.data.friends || admin());
      allow create: if attivo() && request.resource.data.uid == request.auth.uid
        && request.resource.data.la is number && request.resource.data.lo is number && request.resource.data.sp is string
        && request.resource.data.friends is list && request.resource.data.friends.size() <= 200;
      allow delete: if attivo() && (resource.data.uid == request.auth.uid || admin());
    }

    match /banned/{uid} {
      allow read: if attivo() && (request.auth.uid == uid || admin());
      allow write: if admin();
    }
  }
}
