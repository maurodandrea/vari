rules_version = '2';
// Regole di sicurezza per Lenza: ogni utente legge e scrive solo i propri dati (users/{uid}/...).
// Chi si registra con email e password deve prima attivare l'account dal link ricevuto per email;
// gli accessi con Google e Apple hanno già l'email verificata.
// Da incollare in Console Firebase › Firestore Database › Regole › Pubblica.
service cloud.firestore {
  match /databases/{database}/documents {
    function attivo() {
      return request.auth != null
        && (request.auth.token.email_verified == true
            || request.auth.token.firebase.sign_in_provider != 'password');
    }
    match /users/{uid}/{document=**} {
      allow read, write: if attivo() && request.auth.uid == uid;
    }
  }
}
